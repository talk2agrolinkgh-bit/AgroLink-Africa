# Copy to .env and fill in real values before running the app.

# The live site URL — used by the sitemap, robots.txt, and Open Graph tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="https://agrolink.africa"

# Postgres connection string (Supabase / Neon / Railway / local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/agrolink"

# WhatsApp business number in E.164 without "+" (e.g. 233201234567)
NEXT_PUBLIC_WHATSAPP_NUMBER="233200000000"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public sign-in (buyer/supplier/farmer/student) — passwordless magic-link
# email sent via Gmail SMTP. Chosen because it needs no domain ownership —
# Resend/SendGrid/Mailgun/etc. all require a verified custom domain, which
# is a dead end until AgroLink has its own domain.
#
# Setup (uses a Gmail account you already have, no new signup):
#   1. Enable 2-Step Verification: myaccount.google.com/security
#   2. Generate an App Password: myaccount.google.com/apppasswords
#      (choose "Mail" — Google gives you a 16-character code)
#   3. Paste your Gmail address and that code below (not your normal
#      Gmail password — Gmail rejects that for SMTP once 2FA is on)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="AgroLink"
# Without GMAIL_USER/GMAIL_APP_PASSWORD set, sign-in links are logged to the
# server console in development instead of emailed — see src/lib/mail.ts.

# Image storage (choose one, fill in when ready)
CLOUDINARY_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary unsigned uploads — used by every upload zone (Add Product,
# List Your Product, Post Update). Both values are safe to expose to the
# browser (NEXT_PUBLIC_) because the upload preset is unsigned and scoped.
# Set up: Cloudinary dashboard → Settings → Upload → Add upload preset →
# Signing Mode: Unsigned. Without these set, every upload zone shows a
# clear "not configured yet" message instead of pretending to work.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Cloudinary signed API access — server-only, NEVER prefix with NEXT_PUBLIC_.
# Only used to delete an asset when someone removes a file from an
# in-progress form before submitting (see src/lib/cloudinary-admin.ts).
# Find both under Cloudinary dashboard → Settings → Access Keys.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
